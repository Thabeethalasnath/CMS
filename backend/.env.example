# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Configuration
DB_HOST=your-db-host.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_SSL_MODE=require

# Direct JDBC URL (Alternative)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Security Configuration
JWT_SECRET=your-256-bit-hex-or-base64-secret-key-placeholder
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
