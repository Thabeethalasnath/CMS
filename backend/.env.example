# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Configuration
DB_HOST=your-db-host.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_SSL_MODE=require

# Direct JDBC URL (Alternative)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Security Configuration
JWT_SECRET=your-256-bit-hex-or-base64-secret-key-placeholder
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Auth Credentials
ADMIN_USERNAME=asbin.t.s@gmail.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_DISPLAY_NAME=Asbin

# Security & OTP Configuration
OTP_HMAC_SECRET=your-secure-otp-hmac-secret-key

# Transactional SMTP Provider Configuration (e.g. Resend, Brevo, SendGrid, Amazon SES)
# For local dev / test, Mailpit runs on localhost:1025 with no auth required
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your-smtp-api-key
SMTP_FROM_EMAIL=no-reply@kalpanaaa.in
SMTP_FROM_NAME="Kalpanaaa Security"
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
